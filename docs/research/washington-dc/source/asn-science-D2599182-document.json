{"http://asn.desire2learn.com/resources/D2599182":{"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"value":"http://purl.org/ASN/schema/core/StandardDocument","type":"uri"}],"http://purl.org/ASN/schema/core/jurisdiction":[{"value":"http://purl.org/ASN/scheme/ASNJurisdiction/VT","type":"uri"}],"http://purl.org/dc/elements/1.1/title":[{"value":"Next Generation Science Standards","type":"literal","lang":"en-us"}],"http://purl.org/dc/terms/description":[{"value":"Science education in Vermont is currently centered on the Next Generation Science Standards (NGSS), which were adopted by the Vermont State Board of Education in June 2013. These science standards guide classroom instruction to incorporate science content (Disciplinary Core Ideas), relevant practices (Science and Engineering Practices) and unifying authentic ideas (Crosscutting Concepts). The domains of science addressed by this document include Physical Science, Life Science, Earth/Space Science and Engineering Design. Assessment of student understanding of these domains is accomplished through statewide assessment, as well a continuation of ongoing local and classroom assessments. Professional development through the Science Professional Learning Team supports classroom instruction to provide effective science learning for all Vermont students.","type":"literal","lang":"en-us"}],"http://purl.org/dc/terms/source":[{"value":"http://www.nextgenscience.org/next-generation-science-standards","type":"uri"}],"http://purl.org/ASN/schema/core/publicationStatus":[{"value":"http://purl.org/ASN/scheme/ASNPublicationStatus/Published","type":"uri"}],"http://purl.org/ASN/schema/core/repositoryDate":[{"value":"2014-10-22","type":"literal","datatype":"http://purl.org/dc/terms/W3CDTF"}],"http://purl.org/dc/terms/valid":[{"value":"2013","type":"literal","datatype":"http://purl.org/dc/terms/W3CDTF"}],"http://purl.org/dc/terms/tableOfContents":[{"value":"http://asn.desire2learn.com/resources/D2599182_manifest.json","type":"uri