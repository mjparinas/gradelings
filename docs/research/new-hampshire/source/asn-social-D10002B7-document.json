{"http://asn.desire2learn.com/resources/D10002B7":{"http://www.w3.org/1999/02/22-rdf-syntax-ns#type":[{"value":"http://purl.org/ASN/schema/core/StandardDocument","type":"uri"}],"http://purl.org/ASN/schema/core/jurisdiction":[{"value":"http://purl.org/ASN/scheme/ASNJurisdiction/NH","type":"uri"}],"http://purl.org/dc/elements/1.1/title":[{"value":"K-12 Social Studies New Hampshire Curriculum Framework","type":"literal","lang":"en-us"}],"http://purl.org/dc/terms/description":[{"value":"The NH Minimum Standards for Public School Approval require that elementary and middle/junior high school students \"acquire knowledge and understanding of civics, economics, geography, and history\" and require that high school students \"acquire knowledge and modes of inquiry\" in the same four subjects \"including the related areas of sociology, anthropology, and psychology.\" Using this framework, districts can be assured they are guided by the best understandings as to what should be included in social studies courses for the 21st century. In the future, social studies assessments may be developed for the state of New Hampshire that will be based on this framework and should reflect \"best practices in New Hampshire\".","type":"literal","lang":"en-us"}],"http://purl.org/dc/terms/source":[{"value":"http://www.education.nh.gov/instruction/curriculum/social_studies/documents/frameworks.pdf","type":"uri"}],"http://purl.org/ASN/schema/core/publicationStatus":[{"value":"http://purl.org/ASN/scheme/ASNPublicationStatus/Published","type":"uri"}],"http://purl.org/ASN/schema/core/repositoryDate":[{"value":"2011-03-02","type":"literal","datatype":"http://purl.org/dc/terms/W3CDTF"}],"http://purl.org/dc/terms/valid":[{"value":"2006","type":"literal","datatype":"http://purl.org/dc/terms/W3CDTF"}],"http://purl.org/dc/terms/tableOfContents":[{"value":"http://asn.desire2learn.com/resources/D10002B7_manifest.json","type":"uri"}],"http://purl.org/dc/terms/subject":[{"value":"http://purl.org/ASN/scheme/ASNTopic/socialStudies","type":"uri"}],"http://purl.org/dc/terms/educationLevel":[{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/K","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/1","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/2","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/3","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/4","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/5","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/6","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/7","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/8","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/9","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/10","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/11","type":"uri"},{"value":"http://purl.org/ASN/scheme/ASNEducationLevel/12","type":"uri"}],"http://purl.org/ASN/schema/core/identifier":[{"value":"http://purl.org/ASN/resources/D10002B7","type":"uri"}],"http://purl.org/dc/terms/language":[{"value":"http://id.loc.gov/vocabulary/iso639-2/eng","type":"uri"}],"http://purl.org/gem/qualifiers/hasChild":[{"value":"http://asn.desire2learn.com/resources/S10448B7","type":"uri"},{"value":"http://asn.desire2learn.com/resources/S104487E","type":"uri"},{"value":"http://asn.desire2learn.com/resources/S104487F","type":"uri"},{"value":"http://asn.desire2learn.com/resources/S1044880","type":"uri"},{"value":"http://asn.desire2learn.com/resources/S1044881","type":"uri"},{"value":"http://asn.desire2learn.com/resources/S1044882","type":"uri"}]}}