{
  "name": "gradelings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/fetch-piper.mjs --optional && next dev",
    "build": "next build && node scripts/csp-postbuild.mjs",
    "prebuild": "node scripts/fetch-piper.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/coverage-summary.mjs",
    "test:mutation": "stryker run",
    "test:mutation:server": "stryker run stryker.server.config.mjs",
    "curriculum:lock": "UPDATE_LOCKS=1 vitest run src/content/lock.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@sentry/nextjs": "^11.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "onnxruntime-web": "1.30.0",
    "playwright": "^1.56.1",
    "tailwindcss": "^4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
