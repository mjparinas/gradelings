{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["yul1"],
  "crons": [
    { "path": "/api/cron/weekly/", "schedule": "0 15 * * *" },
    { "path": "/api/cron/weekly/?resume=1", "schedule": "0 16-21 * * *" }
  ],
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]"
}
